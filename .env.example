# Copy this file to `.env` in the project root, then fill in values.
# Never commit `.env` (it is gitignored).

# ── Frontend (Vite — restart `npm run dev` after changes) ───────────────────
# Leave empty for local Vite proxy → http://127.0.0.1:8000
VITE_API_URL=

# Optional — only for Study Library cloud uploads (Notes Hub)
# Get both from: https://supabase.com → Project Settings → API
#   Project URL  → VITE_SUPABASE_URL
#   anon public  → VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Backend (set in shell / host dashboard; required in production) ─────────
# local: leave unset or ENVIRONMENT=development
# production: ENVIRONMENT=production
ENVIRONMENT=

# Production — live frontend URL(s), comma-separated
# Live site: https://jntuh-results.duckdns.org
# On Render: set this in the dashboard (Environment), e.g.
#   CORS_ORIGINS=https://jntuh-results.duckdns.org
# If unset, RENDER_EXTERNAL_URL is used as a fallback.
CORS_ORIGINS=

# You generate this yourself (not from a website):
#   PowerShell:  -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
#   or: openssl rand -hex 32
SHARE_TOKEN_SECRET=

# Hall-ticket auto-fetch key for jntuhresults.dhethi.com
# Local default in code is already set; override if fetch breaks.
# Not an official JNTUH key — used by the dhethi results API.
JNTUH_RESULTS_API_KEY=

# ── Optional tuning ─────────────────────────────────────────────────────────
FETCH_RATE_LIMIT_PER_MINUTE=10
PDF_RATE_LIMIT_PER_MINUTE=15
SHARE_RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_MINUTE=30
SHARE_TOKEN_TTL=604800
ENABLE_KEEP_ALIVE=false
# Production public URL (Render sets this automatically on some plans).
# Also used as CORS fallback when CORS_ORIGINS is empty.
# Custom domain example: https://jntuh-results.duckdns.org
RENDER_EXTERNAL_URL=
# Optional alias if the public domain differs from RENDER_EXTERNAL_URL
PUBLIC_APP_URL=

